{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/foiled/catalogue/schema/sequence.schema.json",
  "title": "Foiled sequence (CVE mapping tier 2)",
  "description": "Ordered steps that must all appear, in order, within one attempt and within max_span_ms (#12). Each step names a tier 1 matcher or carries inline conditions. Sequences describe what an exploit chain looks like; they never contain working exploit code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "cve_ids",
    "catalogue_ids",
    "max_span_ms",
    "steps",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "cve_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cve_id"
      }
    },
    "catalogue_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "max_span_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "cve_id": {
      "type": "string",
      "pattern": "^(CVE-[0-9]{4}-[0-9]{4,}|FOILED-DEMO-[0-9]{4})$"
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "matcher": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "channel": {
          "enum": [
            "application",
            "network",
            "hook",
            "dns",
            "egress",
            "filesystem",
            "process",
            "quarantine"
          ]
        },
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "matcher"
          ],
          "not": {
            "required": [
              "all"
            ]
          }
        },
        {
          "required": [
            "all"
          ],
          "not": {
            "required": [
              "matcher"
            ]
          }
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op"
      ],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^(data|hook)\\.[a-z_]+$"
        },
        "op": {
          "enum": [
            "equals",
            "prefix",
            "contains",
            "contains_any",
            "regex"
          ]
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "case_insensitive": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "properties": {
            "op": {
              "const": "contains_any"
            }
          },
          "required": [
            "values"
          ]
        },
        {
          "properties": {
            "op": {
              "enum": [
                "equals",
                "prefix",
                "contains",
                "regex"
              ]
            }
          },
          "required": [
            "value"
          ]
        }
      ]
    }
  }
}

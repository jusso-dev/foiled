{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/foiled/catalogue/schema/advisory.schema.json",
  "title": "Foiled advisory fields (CVE mapping tier 5)",
  "description": "Structured fields taken from a public vendor or CVE advisory (#12): the endpoint it names and whether exploitation needs a session. Used to tell variants on the same endpoint apart and to back-match pre-disclosure watchlist entries. Weak evidence on its own.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cve_id",
    "catalogue_ids",
    "endpoint",
    "auth_requirement",
    "published_at",
    "references"
  ],
  "properties": {
    "cve_id": {
      "type": "string",
      "pattern": "^(CVE-[0-9]{4}-[0-9]{4,}|FOILED-DEMO-[0-9]{4})$"
    },
    "catalogue_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "endpoint": {
      "type": "string",
      "pattern": "^/",
      "maxLength": 512
    },
    "auth_requirement": {
      "enum": [
        "unauth",
        "auth",
        "either"
      ]
    },
    "published_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Advisory publication time, Unix ms."
    },
    "post_exploit_notes": {
      "type": "string",
      "maxLength": 2000
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/foiled/schemas/ioc.schema.json",
  "title": "Foiled indicator of compromise",
  "description": "One indicator extracted from attempts and their capture events, deduplicated by type and value (#34, docs/iocs.md). value is exact and hostile: render display, never value, and never parse display. Mirrors Ioc in crates/core/src/ioc.rs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ioc_id", "type", "value", "display", "roles", "origin", "redacted", "file_ioc_limited", "first_seen", "last_seen", "sightings", "attempt_ids", "campaign_ids", "decoy_ids", "catalogue_ids", "event_ids", "extracted_from", "enrichment", "confidence"],
  "properties": {
    "ioc_id": {
      "type": "string",
      "pattern": "^ioc_[a-f0-9]{24}$",
      "description": "SHA-256 over type and value, truncated. The same value always has the same id."
    },
    "type": { "$ref": "#/$defs/type" },
    "value": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "display": { "type": "string", "description": "Defanged and escaped for people (203[.]0[.]113[.]7, hxxp://...)." },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["source", "request", "payload", "callback", "stage2", "post_exploit", "behaviour"] }
    },
    "origin": {
      "enum": ["observed", "enrichment_pivot"],
      "description": "observed: seen by a Foiled decoy. enrichment_pivot values are never contributed back (#37)."
    },
    "redacted": { "type": "boolean", "description": "Secrets or personal information were removed from value." },
    "file_ioc_limited": {
      "type": "boolean",
      "description": "An attempt this was seen in reached post-exploitation without a captured file (or reported a memory-only implant). File hashes are missing on purpose; no hash is invented."
    },
    "first_seen": { "type": "integer", "description": "Unix ms." },
    "last_seen": { "type": "integer", "description": "Unix ms." },
    "sightings": { "type": "integer", "minimum": 1, "description": "Capture events, or attempts for behaviour_fingerprint." },
    "attempt_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^att_[a-f0-9]{24}$" } },
    "campaign_ids": { "type": "array", "items": { "type": "string" } },
    "decoy_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "catalogue_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "event_ids": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string" } },
    "extracted_from": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(network|application|filesystem|process|quarantine|hook|dns|egress|attempt):[a-z0-9_.+]+$" },
      "description": "channel:field pairs the value was read from."
    },
    "enrichment": {
      "type": "array",
      "description": "ASN and country context for ip and ipv6 (#11). shareable false means the provider is never redistributed and exports drop the ref.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "key", "value", "observed_at", "shareable"],
        "properties": {
          "provider": { "type": "string" },
          "key": { "type": "string", "pattern": "^(asn|geo)\\.[a-z0-9_.]+$" },
          "value": {},
          "observed_at": { "type": "integer" },
          "shareable": { "type": "boolean" }
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "steps"],
      "properties": {
        "version": { "const": 2 },
        "steps": { "type": "array", "minItems": 2, "maxItems": 64, "items": { "type": "string" } }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "band", "wording", "publishable", "evidence", "caps_applied"],
      "description": "The #27 score for the indicator (link kind attempt_ioc).",
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "band": { "enum": ["low", "medium", "high"] },
        "wording": { "enum": ["we assess as", "confirmed"] },
        "publishable": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signal_id", "source", "weight", "summary"],
            "properties": {
              "signal_id": { "type": "string" },
              "source": { "enum": ["rule", "sequence", "vuln_path_hook", "catalogue_prior", "vendor_desc", "predisclosure_backmatch", "enrichment", "llm", "analyst", "campaign_cluster", "noise_score"] },
              "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
              "summary": { "type": "string" },
              "ref": { "type": "string" }
            }
          }
        },
        "caps_applied": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "ip" } } },
      "then": { "properties": { "value": { "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$" } } }
    },
    {
      "if": { "properties": { "type": { "const": "ipv6" } } },
      "then": { "properties": { "value": { "pattern": "^[0-9a-f:.]+$" } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["domain", "dns_query"] } } },
      "then": { "properties": { "value": { "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+$", "maxLength": 253 } } }
    },
    {
      "if": { "properties": { "type": { "const": "url" } } },
      "then": { "properties": { "value": { "pattern": "^(http|https|ftp)://[^\\s]+$" } } }
    },
    {
      "if": { "properties": { "type": { "const": "http_path" } } },
      "then": { "properties": { "value": { "pattern": "^/" } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["payload_sha256", "file_sha256"] } } },
      "then": { "properties": { "value": { "pattern": "^[a-f0-9]{64}$" } } }
    },
    {
      "if": { "properties": { "type": { "const": "behaviour_fingerprint" } } },
      "then": { "required": ["fingerprint"], "properties": { "fingerprint": { "type": "object" }, "value": { "pattern": "^bf2:[a-f0-9]{32}$" } } },
      "else": { "properties": { "fingerprint": false } }
    }
  ],
  "$defs": {
    "type": {
      "enum": ["ip", "ipv6", "domain", "url", "http_path", "http_ua", "request_substring", "payload_sha256", "file_sha256", "cmdline", "dns_query", "behaviour_fingerprint"]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/foiled/schemas/agent/signed-job.schema.json",
  "title": "Foiled signed job",
  "description": "A job as leased by a host. body is the JSON text of job.schema.json; sig is the hex Ed25519 signature over its UTF-8 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "sig", "key_id"],
  "properties": {
    "body": { "type": "string", "contentMediaType": "application/json" },
    "sig": { "type": "string", "pattern": "^[a-f0-9]{128}$" },
    "key_id": { "type": "string", "minLength": 1 }
  }
}

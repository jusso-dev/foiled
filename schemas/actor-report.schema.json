{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/foiled/schemas/actor-report.schema.json",
  "title": "Foiled actor report profile",
  "description": "One curated actor profile built only from public sources (#29): label, pinned sources with licences, techniques, infrastructure and tooling indicators, targeting and the geography a report mentions (never evidence). Real entries live in catalogue/actors/; fictional examples (example: true) only under testdata/actors/reports/. foiled-core checks what a schema cannot: technique ids against the ATT&CK sidecar, attribution wording, two publishers for a named group, sha256 pins on real entries, and documentation values on examples. See docs/actor-attribution.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "sources", "techniques"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
      "description": "Lowercase slug. The actor id is report:<id>."
    },
    "example": {
      "type": "boolean",
      "default": false,
      "description": "Fictional entry for tests and docs. Labels start with EXAMPLE, publishers say (fictional), and every value is a documentation address, ASN or reserved domain."
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "enum": ["nexus", "cluster", "named_group"],
          "description": "Prefer nexus or cluster. named_group needs sources from at least two publishers."
        },
        "text": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "aliases": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "publisher", "title", "url", "published", "retrieved", "licence"],
        "properties": {
          "kind": { "enum": ["vendor_report", "government_advisory", "misp_galaxy"] },
          "publisher": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "published": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the document as retrieved: the pin. Required on real entries."
          },
          "licence": { "type": "string", "minLength": 1 },
          "licence_url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "techniques": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" }
    },
    "indicators": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": { "enum": ["ip", "cidr", "domain", "url", "sha256", "asn"] },
          "value": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "source": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Index into sources of the report that lists the indicator."
          }
        }
      }
    },
    "targeting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cves": { "type": "array", "items": { "type": "string" } },
        "catalogue_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "description": "Geography the report mentions. Recorded so a match can say it was not counted; never evidence.",
      "properties": {
        "source_countries": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z]{2}$" }
        }
      }
    },
    "notes": { "type": "string", "maxLength": 1000 }
  }
}

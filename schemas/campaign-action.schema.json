{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/foiled/schemas/campaign-action.schema.json",
  "title": "Foiled campaign analyst action",
  "description": "One audited analyst action on a campaign (#33, docs/campaigns.md#analyst-actions): label, status, merge, split or feedback. Stored append-only and replayed in (at, action_id) order over the computed clustering. Actions follow anchor_attempt_id, the campaign's seed when the action was taken. Mirrors CampaignAction in crates/core/src/campaign.rs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "kind",
    "campaign_id",
    "anchor_attempt_id",
    "note",
    "analyst_id",
    "at"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "label",
        "status",
        "merge",
        "split",
        "feedback"
      ]
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^cmp_[a-f0-9]{24}$"
    },
    "anchor_attempt_id": {
      "type": "string",
      "pattern": "^att_[a-f0-9]{24}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "enum": [
        "emerging",
        "active",
        "closed"
      ]
    },
    "merge": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "campaign_id",
          "anchor_attempt_id"
        ],
        "properties": {
          "campaign_id": {
            "type": "string",
            "pattern": "^cmp_[a-f0-9]{24}$"
          },
          "anchor_attempt_id": {
            "type": "string",
            "pattern": "^att_[a-f0-9]{24}$"
          }
        }
      }
    },
    "attempt_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "string",
        "pattern": "^att_[a-f0-9]{24}$"
      }
    },
    "feedback": {
      "enum": [
        "true_positive",
        "false_positive",
        "unsure"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    },
    "analyst_id": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "integer"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "label"
          }
        }
      },
      "then": {
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "else": {
        "properties": {
          "title": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "merge"
          }
        }
      },
      "then": {
        "required": [
          "merge"
        ],
        "properties": {
          "merge": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "campaign_id",
                "anchor_attempt_id"
              ],
              "properties": {
                "campaign_id": {
                  "type": "string",
                  "pattern": "^cmp_[a-f0-9]{24}$"
                },
                "anchor_attempt_id": {
                  "type": "string",
                  "pattern": "^att_[a-f0-9]{24}$"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "merge": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "split"
          }
        }
      },
      "then": {
        "required": [
          "attempt_ids"
        ],
        "properties": {
          "attempt_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "string",
              "pattern": "^att_[a-f0-9]{24}$"
            }
          }
        }
      },
      "else": {
        "properties": {
          "attempt_ids": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "feedback"
          }
        }
      },
      "then": {
        "required": [
          "feedback"
        ],
        "properties": {
          "feedback": {
            "enum": [
              "true_positive",
              "false_positive",
              "unsure"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "feedback": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "status"
          }
        }
      },
      "else": {
        "properties": {
          "status": false
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/foiled/schemas/write-up.schema.json",
  "title": "Foiled research write-up",
  "description": "A research write-up (#35) as the operator API returns it: draft, review, approved, published or withdrawn, with its Markdown body, TLP, embargo, the second reviewer's checklist and a version per change. The public exploit page is a separate, allow-listed snapshot (public-exploit-page.schema.json). Mirrored by foiled_core::writeup::WriteUp. See docs/research-writeups.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["writeup_id", "tenant_id", "slug", "title", "summary", "body_md", "status", "tlp", "embargo_until", "cve_ids", "technique_ids", "campaign_ids", "ioc_ids", "attempt_ids", "first_seen", "redacted_payload", "source_item_id", "author_id", "reviewer_id", "checklist", "version", "created_at", "updated_at", "submitted_at", "approved_at", "published_at", "withdrawn_at"],
  "properties": {
    "writeup_id": { "type": "string", "pattern": "^wu_[a-f0-9]{24}$" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "title": { "type": "string", "maxLength": 160 },
    "summary": { "type": "string", "maxLength": 400 },
    "body_md": { "description": "Markdown subset (docs/research-writeups.md#markdown). Never rendered as HTML.", "type": "string", "maxLength": 65536 },
    "status": { "enum": ["draft", "review", "approved", "published", "withdrawn"] },
    "tlp": { "enum": ["clear", "green", "amber", "amber+strict", "red"] },
    "embargo_until": { "type": ["integer", "null"] },
    "cve_ids": { "type": "array", "maxItems": 50, "items": { "type": "string", "pattern": "^(CVE-[0-9]{4}-[0-9]{4,7}|FOILED-DEMO-[0-9]{4})$" } },
    "technique_ids": { "type": "array", "maxItems": 50, "items": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" } },
    "campaign_ids": { "type": "array", "maxItems": 50, "items": { "type": "string", "pattern": "^cmp_[a-f0-9]{24}$" } },
    "ioc_ids": { "type": "array", "maxItems": 50, "items": { "type": "string", "pattern": "^ioc_[a-f0-9]{24}$" } },
    "attempt_ids": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
    "first_seen": { "type": ["integer", "null"] },
    "redacted_payload": { "type": ["string", "null"], "maxLength": 2000 },
    "source_item_id": { "type": ["string", "null"], "pattern": "^rq_[a-f0-9]{24}$" },
    "author_id": { "type": "string", "minLength": 1 },
    "reviewer_id": { "type": ["string", "null"] },
    "checklist": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenant_data_removed", "wording_checked", "no_exploit_code", "payloads_redacted", "sources_linked", "delay_rules_checked"],
          "properties": {
            "tenant_data_removed": { "type": "boolean" },
            "wording_checked": { "type": "boolean" },
            "no_exploit_code": { "type": "boolean" },
            "payloads_redacted": { "type": "boolean" },
            "sources_linked": { "type": "boolean" },
            "delay_rules_checked": { "type": "boolean" }
          }
        }
      ]
    },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "integer" },
    "updated_at": { "type": "integer" },
    "submitted_at": { "type": ["integer", "null"] },
    "approved_at": { "type": ["integer", "null"] },
    "published_at": { "type": ["integer", "null"] },
    "withdrawn_at": { "type": ["integer", "null"] },
    "lint": {
      "description": "Lint findings for the current version. Errors block submit, approve and publish.",
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "severity", "location", "message"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning"] },
        "location": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jusso-dev/foiled/schemas/radar-feed.schema.json",
  "title": "Foiled radar feed",
  "description": "Aggregated, confidence-gated counts and trends per CVE, technique, campaign and product, with headline cards (#35). Returned by GET /v0/radar (tenant or fleet audience) and GET /v0/public/radar (public audience). Only counts: never a tenant, sensor, source address or attempt. Mirrored by foiled_core::radar::RadarFeed. See docs/radar.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["audience", "generated_at", "since", "until", "policy", "series", "cards", "notes"],
  "properties": {
    "audience": { "enum": ["public", "fleet", "tenant"] },
    "generated_at": { "type": "integer" },
    "since": { "description": "First day shown, UTC midnight Unix ms.", "type": "integer" },
    "until": {
      "description": "Day after the last day shown. Earlier than requested while the delay holds days back.",
      "type": "integer"
    },
    "policy": {
      "description": "The limits that applied.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_sources",
        "min_sensors",
        "min_edge_tenants",
        "delay_days",
        "min_confidence",
        "publishable_only"
      ],
      "properties": {
        "min_sources": { "type": "integer", "minimum": 1 },
        "min_sensors": { "type": "integer", "minimum": 1 },
        "min_edge_tenants": { "type": "integer", "minimum": 1 },
        "delay_days": { "type": "integer", "minimum": 0 },
        "min_confidence": { "enum": ["low", "medium", "high"] },
        "publishable_only": { "type": "boolean" }
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "key",
          "label",
          "wording",
          "total_attempts",
          "total_sources",
          "best_band",
          "first_day",
          "last_day",
          "days",
          "trend"
        ],
        "properties": {
          "dimension": { "enum": ["cve", "technique", "campaign", "product"] },
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "wording": {
            "description": "we assess as (CVE, technique), possible (campaign) or observed (product).",
            "enum": ["we assess as", "possible", "observed"]
          },
          "total_attempts": { "type": "integer", "minimum": 0 },
          "total_sources": { "type": "integer", "minimum": 0 },
          "best_band": { "enum": ["low", "medium", "high"] },
          "first_day": { "type": "integer" },
          "last_day": { "type": "integer" },
          "days": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["day", "attempts", "publishable_attempts", "sources"],
              "properties": {
                "day": { "type": "integer" },
                "attempts": { "type": "integer", "minimum": 0 },
                "publishable_attempts": { "type": "integer", "minimum": 0 },
                "sources": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "trend": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direction", "pct"],
            "properties": {
              "direction": { "enum": ["up", "down", "flat"] },
              "pct": { "type": "integer" }
            }
          }
        }
      }
    },
    "cards": {
      "description": "Headlines, newest first. Built from publishable counts only, so a low-confidence or LLM-only link never becomes a headline.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "card_id",
          "kind",
          "dimension",
          "key",
          "day",
          "attempts",
          "sources",
          "headline"
        ],
        "properties": {
          "card_id": { "type": "string", "pattern": "^rc_[a-f0-9]{24}$" },
          "kind": {
            "enum": ["new_cve_assessment", "predisclosure_spike", "campaign_emergence", "spike"]
          },
          "dimension": { "enum": ["cve", "technique", "campaign", "product"] },
          "key": { "type": "string", "minLength": 1 },
          "day": { "type": "integer" },
          "attempts": { "type": "integer", "minimum": 0 },
          "sources": { "type": "integer", "minimum": 0 },
          "headline": { "type": "string", "minLength": 1 }
        }
      }
    },
    "suppressed_buckets": {
      "description": "Buckets held back by the thresholds. Absent on the public radar.",
      "type": "integer",
      "minimum": 0
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}

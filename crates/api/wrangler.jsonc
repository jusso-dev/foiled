{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Control plane API Worker (ADR 0009). Placeholder IDs only: no account IDs,
  // zone names or routes in the public repo. Secrets via `wrangler secret put`.
  "name": "foiled-api",
  "main": "build/worker/shim.mjs",
  "build": { "command": "cargo install -q worker-build && worker-build --release" },
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // No workers.dev or preview URLs: they would bypass Access and the mTLS rule.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foiled-config",
      "database_id": "<d1-database-id>",
      "migrations_dir": "../../migrations/d1"
    }
  ],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-config-id>" }],
  // Capture ingest (#9): the API produces, and the same Worker consumes.
  "queues": {
    "producers": [{ "binding": "INGEST", "queue": "foiled-ingest" }],
    "consumers": [
      {
        "queue": "foiled-ingest",
        "max_batch_size": 100,
        "max_retries": 5,
        "dead_letter_queue": "foiled-ingest-dlq"
      }
    ]
  },
  // Evidence bucket, private. Hosts upload through presigned S3 API URLs;
  // the R2 S3 credentials are Worker secrets R2_ACCESS_KEY_ID and
  // R2_SECRET_ACCESS_KEY, scoped to this bucket only.
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "foiled-evidence" }],
  "vars": {
    "EVIDENCE_BUCKET": "foiled-evidence",
    "R2_S3_HOST": "<account-id>.r2.cloudflarestorage.com"
  },
  // Radar counters (#35).
  "analytics_engine_datasets": [{ "binding": "RADAR", "dataset": "foiled_radar" }]
}

{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Control plane API Worker (ADR 0009). Placeholder IDs only: no account IDs,
  // zone names or routes in the public repo. Secrets via `wrangler secret put`.
  "name": "foiled-api",
  "main": "build/worker/shim.mjs",
  "build": { "command": "cargo install -q worker-build && worker-build --release" },
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // No workers.dev or preview URLs: they would bypass Access and the mTLS rule.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foiled-config",
      "database_id": "<d1-database-id>",
      "migrations_dir": "../../migrations/d1"
    }
  ],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-config-id>" }],
  // Capture ingest (#9): the API produces, and the same Worker consumes.
  // Enrichment (#11): the ingest consumer produces observables to
  // foiled-enrich (the name must match `queue` in configs/enrichment.yaml),
  // and the same Worker consumes them in batches: one ThreatSieve lookup
  // carries up to a whole batch. A full batch of 100 is about 500 D1 queries
  // (five per message at most), which needs the Workers Paid plan's 1,000
  // per invocation; on the Free plan (50) set max_batch_size to 8 or less.
  "queues": {
    "producers": [
      { "binding": "INGEST", "queue": "foiled-ingest" },
      { "binding": "ENRICH", "queue": "foiled-enrich" }
    ],
    "consumers": [
      {
        "queue": "foiled-ingest",
        "max_batch_size": 100,
        "max_retries": 5,
        "dead_letter_queue": "foiled-ingest-dlq"
      },
      {
        "queue": "foiled-enrich",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        "max_concurrency": 1,
        "max_retries": 5,
        "dead_letter_queue": "foiled-enrich-dlq"
      }
    ]
  },
  // Evidence bucket, private. Hosts upload through presigned S3 API URLs;
  // the R2 S3 credentials are Worker secrets R2_ACCESS_KEY_ID and
  // R2_SECRET_ACCESS_KEY, scoped to this bucket only.
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "foiled-evidence" }],
  "vars": {
    "EVIDENCE_BUCKET": "foiled-evidence",
    // Names the Ed25519 job signing key; the seed is the secret JOB_SIGNING_KEY (#41).
    "JOB_SIGNING_KEY_ID": "k1",
    "R2_S3_HOST": "<account-id>.r2.cloudflarestorage.com"
  },
  // ThreatSieve (#11) is opt-in and NOT bound here: a deploy with a service
  // binding to a Worker that does not exist fails. Operators who run
  // ThreatSieve add the THREATSIEVE binding to their private copy of this
  // file (docs/deploy/workers.md, "Optional: ThreatSieve"). Without it,
  // enrichment runs local_asn only.
  // Hourly purge of expired enrichment cache and failure rows (#16).
  "triggers": { "crons": ["17 * * * *"] },
  // Radar counters (#35).
  "analytics_engine_datasets": [{ "binding": "RADAR", "dataset": "foiled_radar" }]
}
